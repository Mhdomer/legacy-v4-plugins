#!/usr/bin/env python3
"""CLI utility to import custom GIFs, spritesheets, or animations into NoctaCat."""

import argparse
import json
import os
import shutil
import subprocess
import sys
from pathlib import Path

def resolve_project_root() -> Path:
    return Path(__file__).resolve().parent.parent

def detect_dark_monochrome(first_frame: Path) -> bool:
    try:
        cmd = [
            "magick",
            str(first_frame),
            "-format",
            "%[fx:mean.r],%[fx:mean.g],%[fx:mean.b],%[fx:standard_deviation]",
            "info:"
        ]
        out = subprocess.check_output(cmd, text=True).strip()
        parts = [float(p) for p in out.split(",")]
        r, g, b, std = parts[0], parts[1], parts[2], parts[3]
        avg_lum = (r + g + b) / 3.0
        # If mean RGB is low (< 0.35) and low standard deviation across color channels, it is a dark silhouette.
        return avg_lum < 0.35 and abs(r - g) < 0.08 and abs(g - b) < 0.08
    except Exception:
        return False

def import_runner(
    input_path: Path,
    runner_id: str,
    display_name: str,
    author: str,
    runner_type: str,
    tags: list[str],
    max_frames: int = 16,
    invert_dark: bool = True
) -> None:
    project_root = resolve_project_root()
    runners_dir = project_root / "runners"
    target_dir = runners_dir / runner_id
    manifest_path = project_root / "runners.json"

    if not input_path.exists():
        print(f"Error: input file '{input_path}' not found.", file=sys.stderr)
        sys.exit(1)

    target_dir.mkdir(parents=True, exist_ok=True)
    temp_dir = target_dir / ".tmp_extract"
    temp_dir.mkdir(exist_ok=True)

    try:
        is_video = input_path.suffix.lower() in [".mp4", ".webm", ".mkv", ".mov"]
        if is_video:
            cmd = [
                "ffmpeg",
                "-y",
                "-i", str(input_path),
                "-vf", f"scale=-1:48:flags=lanczos,fps=10",
                "-vframes", str(max_frames),
                str(temp_dir / "frame-%02d.png")
            ]
        else:
            cmd = [
                "magick",
                str(input_path),
                "-coalesce",
                "-resize", "x48>",
                "-background", "none",
                str(temp_dir / "frame-%02d.png")
            ]

        subprocess.check_call(cmd, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        extracted = sorted(temp_dir.glob("frame-*.png"))
        if not extracted:
            print("Error: failed to extract animation frames.", file=sys.stderr)
            sys.exit(1)

        # Truncate if frames exceed max_frames to keep memory light
        if len(extracted) > max_frames:
            for extra in extracted[max_frames:]:
                extra.unlink()
            extracted = extracted[:max_frames]

        # Auto-detect if silhouette needs white inversion for dark bars
        first_frame = extracted[0]
        is_dark = detect_dark_monochrome(first_frame)
        should_invert = invert_dark and is_dark and (runner_type != "color")

        final_frames = []
        for idx, src_frame in enumerate(extracted):
            dest_frame = target_dir / f"frame-{idx}.png"
            if should_invert:
                # Invert RGB to pure white while preserving alpha channel
                subprocess.check_call([
                    "magick",
                    str(src_frame),
                    "-channel", "RGB",
                    "-negate",
                    "+channel",
                    str(dest_frame)
                ])
            else:
                shutil.copy2(src_frame, dest_frame)
            final_frames.append(dest_frame)

        # Create preview and sleep sprites
        shutil.copy2(final_frames[0], target_dir / "preview.png")
        shutil.copy2(final_frames[0], target_dir / "sleep.png")

        # Determine effective runner type
        effective_type = "monochrome" if should_invert or runner_type == "monochrome" else runner_type
        if runner_type == "auto":
            effective_type = "monochrome" if should_invert else "color"

        # Update runners.json
        manifest = {"runners": []}
        if manifest_path.exists():
            with open(manifest_path, "r", encoding="utf-8") as f:
                manifest = json.load(f)

        existing = [r for r in manifest.get("runners", []) if r.get("id") != runner_id]
        new_entry = {
            "id": runner_id,
            "displayName": display_name,
            "author": author,
            "type": effective_type,
            "frameCount": len(final_frames),
            "hasSleep": True,
            "tags": tags
        }
        existing.append(new_entry)
        manifest["runners"] = sorted(existing, key=lambda x: x.get("displayName", "").lower())

        with open(manifest_path, "w", encoding="utf-8") as f:
            json.dump(manifest, f, indent=2)

        print(f"Successfully imported runner '{runner_id}' ({display_name}):")
        print(f"  Frames: {len(final_frames)}")
        print(f"  Type: {effective_type}")
        print(f"  Directory: {target_dir}")
        print("  Updated runners.json catalog.")
    finally:
        shutil.rmtree(temp_dir, ignore_errors=True)

def main() -> None:
    parser = argparse.ArgumentParser(
        description="Import custom GIF, webp, or video animations into NoctaCat."
    )
    parser.add_argument("input", type=Path, help="Path to GIF, sprite, or video file")
    parser.add_argument("--id", type=str, required=True, help="Unique runner ID (e.g. nyan-cat)")
    parser.add_argument("--name", type=str, default="", help="Display name (e.g. Nyan Cat)")
    parser.add_argument("--author", type=str, default="Community", help="Original creator / designer")
    parser.add_argument("--type", choices=["auto", "color", "monochrome"], default="auto", help="Sprite color type")
    parser.add_argument("--tags", type=str, default="custom", help="Comma-separated category tags")
    parser.add_argument("--max-frames", type=int, default=16, help="Maximum frames to keep (default: 16)")
    parser.add_argument("--no-invert", action="store_true", help="Do not invert dark silhouettes to white")

    args = parser.parse_args()
    display_name = args.name if args.name else args.id.replace("-", " ").title()
    tags = [t.strip() for t in args.tags.split(",") if t.strip()]

    import_runner(
        input_path=args.input,
        runner_id=args.id.strip().lower(),
        display_name=display_name,
        author=args.author,
        runner_type=args.type,
        tags=tags,
        max_frames=args.max_frames,
        invert_dark=not args.no_invert
    )

if __name__ == "__main__":
    main()
